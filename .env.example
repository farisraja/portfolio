# PostgreSQL Database Connection URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/portfolio_db

# Secret key used for signing cookies and JWTs by Payload CMS
PAYLOAD_SECRET=your-secure-random-payload-secret-at-least-32-chars

# Base URL for public site and admin
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
